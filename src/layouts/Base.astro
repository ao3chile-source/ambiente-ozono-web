---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isDraft } from '../data/site.js';
const { title, description = 'Venta y arriendo de sistemas de ozono para agua, aire, alimentos, riego y minería. Representantes oficiales en Chile de Sewec Ozon, Alemania.', dark = false } = Astro.props;
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isDraft && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/logo-ao3.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Header dark={dark} />
    <main><slot /></main>
    <Footer />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.remove('pending'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top > innerHeight) { el.classList.add('pending'); io.observe(el); }
        });
      }
    </script>
  </body>
</html>
