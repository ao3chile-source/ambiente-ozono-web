---
import { faqs } from '../data/site.js';
---
<div class="faq">
  {faqs.map((f, i) => (
    <details open={i === 0}>
      <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq{border-top:1px solid var(--line);}
  details{border-bottom:1px solid var(--line);}
  summary{list-style:none; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:20px; padding:22px 0; font-family:var(--font-display); font-weight:600; font-size:clamp(19px,2vw,23px); font-stretch:106%;}
  summary::-webkit-details-marker{display:none;}
  summary:focus-visible{outline:2px solid var(--sky); outline-offset:4px;}
  i{flex:none; width:28px; height:28px; border-radius:50%; border:1.5px solid var(--brand); position:relative;}
  i::before, i::after{content:""; position:absolute; left:50%; top:50%; width:11px; height:1.5px; background:var(--brand); transform:translate(-50%,-50%);}
  i::after{transform:translate(-50%,-50%) rotate(90deg); transition:transform .2s;}
  details[open] i::after{transform:translate(-50%,-50%) rotate(0deg);}
  details p{padding:0 0 24px; color:var(--muted); max-width:70ch; font-size:16.5px;}
</style>
