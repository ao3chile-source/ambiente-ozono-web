---
import { contact, nav, waLink } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <span class="logo-chip"><img src="/logo-ao3.png" alt="Ambiente Ozono" width="148" height="38" /></span>
      <p>Soluciones de ozono para la industria chilena. Representantes oficiales en Chile de Sewec Ozon, Alemania.</p>
    </div>
    <nav aria-label="Pie de página">
      <span class="eyebrow">Sitio</span>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div>
      <span class="eyebrow">Contacto</span>
      <a href={waLink()} target="_blank" rel="noopener">WhatsApp {contact.whatsappLabel}</a>
      <span class="mono select">{contact.email}</span>
      <a href={contact.instagram} target="_blank" rel="noopener">Instagram @ambienteozono</a>
    </div>
  </div>
  <div class="wrap legal">
    <span>© {year} Ambiente Ozono · Chile</span>
  </div>
</footer>

<style>
  .site-footer{background:var(--navy); color:rgba(255,255,255,.82); padding-block:64px 28px;}
  .grid{display:grid; grid-template-columns:1.4fr 1fr 1fr; gap:40px;}
  .grid > *{display:flex; flex-direction:column; gap:10px; min-width:0;}
  .brand p{max-width:36ch; font-size:15px;}
  .logo-chip{background:#fff; border-radius:10px; padding:8px 12px; align-self:flex-start; display:flex;}
  .logo-chip img{height:32px; width:auto;}
  .eyebrow{color:var(--sky); margin-bottom:4px;}
  a{text-decoration:none; font-size:15px;}
  a:hover{color:#fff;}
  .select{font-size:13.5px; user-select:all; overflow-wrap:anywhere;}
  .legal{margin-top:48px; padding-top:20px; border-top:1px solid rgba(255,255,255,.12); font-size:13px; opacity:.7;}
  @media (max-width:760px){ .grid{grid-template-columns:1fr;} }
</style>
