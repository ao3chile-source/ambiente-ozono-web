---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="Preguntas frecuentes · Ambiente Ozono" dark>
  <PageHead eyebrow="Preguntas frecuentes" title="El ozono, explicado sin rodeos." lead="Qué es, cómo se genera, cómo actúa y cómo se usa con seguridad." />
  <section class="section">
    <div class="wrap narrow reveal"><Faq /></div>
  </section>
  <CtaBand title="¿Tienes otra pregunta?" text="Escríbenos por WhatsApp y te respondemos con información técnica para tu caso." />
</Base>
<style>.narrow{max-width:860px;}</style>
